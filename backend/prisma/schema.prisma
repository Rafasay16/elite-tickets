generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  cpf          String?       @unique // CPF para convidados/compradores e obrigatório para organizadores
  cnpj         String?       @unique // CNPJ para organizadores (opcional)
  responsavel  String? // Nome do responsável pela produtora
  password     String? // Senha para autenticação
  city         String? // Cidade do cliente
  phone        String? // Telefone do cliente
  role         String        @default("CLIENT")
  isActive     Boolean       @default(true) // Controle de banimento pelo Super Admin
  feeRate      Float         @default(0.15) // Taxa de serviço (ex: 0.15 = 15%)
  eventLimit   Int           @default(5) // Limite de eventos criados pelo organizador
  photoUrl     String? // URL do avatar escolhido
  preferences  String? // Preferências salvas como JSON string
  creatorId    String? // Vincula o Porteiro ao Organizador que o criou
  reservations Reservation[]
  events       Event[]       @relation("OrganizerEvents") // Apenas para ORGANIZER
  scannedReservations Reservation[] @relation("ScannedReservations")
  paymentMethods PaymentMethod[]
}

model PaymentMethod {
  id         String @id @default(uuid())
  userId     String
  brand      String   // "visa", "mastercard", etc.
  lastFour   String   // "4242"
  holderName String   // Nome no cartão
  user       User     @relation(fields: [userId], references: [id])
}

model Event {
  id                String        @id @default(uuid())
  externalId        String?       // ID da API externa (TMDb ou Ticketmaster)
  type              String        @default("MOVIE") // MOVIE ou SHOW
  title             String
  description       String? // Descrição longa do evento
  category          String? // Categoria do evento (Ex: Show, Palestra)
  posterUrl         String?
  backdropUrl       String?
  date              DateTime
  location          String
  city              String        @default("São Paulo") // Cidade do cinema/evento
  priceInCents      Int           // Preço em centavos (ex: R$50,00 = 5000)
  capacity          Int
  rating            String   @default("Livre") // Classificacao indicativa (Livre, 10, 12, 14, 16, 18)
  maxTicketsPerUser Int           @default(4) // Limite de compras por usuário
  status            String        @default("PUBLISHED")
  organizerId       String
  organizer         User          @relation("OrganizerEvents", fields: [organizerId], references: [id])
  seats             Seat[]
  reservations      Reservation[]
}

model Seat {
  id           String        @id @default(uuid())
  eventId      String
  row          String
  number       Int
  status       String        @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD, CORTESIA
  event        Event         @relation(fields: [eventId], references: [id])
  reservations Reservation[]

  @@unique([eventId, row, number])
}

model Reservation {
  id        String    @id @default(uuid())
  userId    String
  eventId   String
  seatId    String
  status    String // RESERVED, PAID, CANCELLED, USED
  expiresAt DateTime? // Tempo limite para pagar
  createdAt DateTime  @default(now())

  scannedAt DateTime?
  scannedById String?

  user    User    @relation(fields: [userId], references: [id])
  event   Event   @relation(fields: [eventId], references: [id])
  seat    Seat    @relation(fields: [seatId], references: [id])
  scannedBy User? @relation("ScannedReservations", fields: [scannedById], references: [id])
  ticket  Ticket?
}

model Ticket {
  id            String      @id @default(uuid())
  reservationId String      @unique
  qrCodeData    String      // JWT assinado (dados opacos do QR Code)
  issuedAt      DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

